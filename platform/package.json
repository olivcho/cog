{
  "name": "@internal/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/client.ts",
    "./auth": "./src/auth/index.ts",
    "./permissions": "./src/permissions/index.ts",
    "./audit": "./src/audit/index.ts",
    "./approvals": "./src/approvals/index.ts",
    "./models": "./src/models/index.ts",
    "./models/registry": "./src/models/registry.ts",
