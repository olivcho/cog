// Demo uses SQLite for zero-config local execution.
// For production managed Postgres (AWS RDS, Supabase, Neon):
//   1. Change provider below to "postgresql"
//   2. Set DATABASE_URL to your Postgres connection string
//   3. Run `pnpm db:push` (or `prisma migrate deploy`)
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   // analyst | senior_reviewer | compliance_admin | auditor
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  auditLogs     AuditLog[]
  assignedCases KycCase[]      @relation("AssignedCases")
  approvalSteps ApprovalStep[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Append-only audit trail. Platform code never exposes update/delete operations.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  action     String   // create | update | delete | approve | reject | escalate | assign | login | logout
  entityType String
  entityId   String
  beforeJson String?
  afterJson  String?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// Generic approval state machine with optional two-person sign-off.
model ApprovalRequest {
  id                String         @id @default(cuid())
  entityType        String
  entityId          String
  status            String         @default("pending") // pending | pending_second_approval | approved | rejected | escalated
  requiredApprovals Int            @default(1)
  riskScore         Int            @default(0)
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  steps             ApprovalStep[]

  @@index([entityType, entityId])
  @@index([status])
}

model ApprovalStep {
  id                String          @id @default(cuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  stepNumber        Int
  actorId           String
  actor             User            @relation(fields: [actorId], references: [id], onDelete: Restrict)
  decision          String          // approved | rejected | escalated
  reason            String
  createdAt         DateTime        @default(now())

  @@unique([approvalRequestId, stepNumber])
  @@index([actorId])
}

// First vertical app: KYC Review Queue
model KycCase {
  id            String   @id @default(cuid())
  caseNumber    String   @unique
  customerName  String
  customerEmail String
  country       String
  accountType   String   // individual | business
  riskScore     Int      // 0 - 100
  status        String   @default("open") // open | in_review | pending_second_approval | approved | rejected | escalated
  slaDueAt      DateTime
  assigneeId    String?
  assignee      User?    @relation("AssignedCases", fields: [assigneeId], references: [id], onDelete: SetNull)
  summary       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  documents        KycDocument[]
  sanctionsMatches SanctionsMatch[]

  @@index([status])
  @@index([riskScore])
  @@index([assigneeId])
  @@index([slaDueAt])
}

model KycDocument {
  id            String   @id @default(cuid())
  kycCaseId     String
  kycCase       KycCase  @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  docType       String   // passport | drivers_license | proof_of_address | bank_statement | corporate_filing
  fileName      String
  status        String   @default("pending") // verified | pending | flagged
  extractedJson String
  uploadedAt    DateTime @default(now())

  @@index([kycCaseId])
}

model SanctionsMatch {
  id          String   @id @default(cuid())
  kycCaseId   String
  kycCase     KycCase  @relation(fields: [kycCaseId], references: [id], onDelete: Cascade)
  listName    String   // OFAC_SDN | EU_SANCTIONS | UN_SANCTIONS | PEP_GLOBAL
  matchedName String
  matchScore  Int      // 0 - 100
  category    String   // sanctions | pep | adverse_media
  details     String
  disposition String   @default("pending") // pending | confirmed | false_positive
  createdAt   DateTime @default(now())

  @@index([kycCaseId])
}
